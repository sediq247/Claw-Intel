# Host-run API connection. Compose uses DOCKER_DATABASE_URL (or its `db` service default)
# so a localhost DATABASE_URL here cannot accidentally point a container at itself.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://clawintel:clawintel@localhost:5432/clawintel
# Optional Compose-only override for a remote/managed PostgreSQL server. Leave unset for local Compose.
# DOCKER_DATABASE_URL=postgresql+asyncpg://clawintel:replace-me@db:5432/clawintel
ALLOWED_ORIGINS=http://localhost:6548,http://127.0.0.1:6548,http://localhost:8000,http://127.0.0.1:8000
PORT=6548
COOKIE_SECURE=false
AUTO_SCAN_ENABLED=true
AUTO_SCAN_INTERVAL_SECONDS=300
PUBLIC_BASE_URL=https://your-public-host.example
TELEGRAM_BOT_TOKEN=
# Required in production; generate 32+ random characters and share across replicas.
RATE_LIMIT_KEY_SECRET=
TELEGRAM_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
AUTO_SCAN_REVISIT_CHANGE_PCT=15
AUTO_SCAN_MIN_REVISIT_SECONDS=900

# Bounded evidence-based debates. Output budget counts provider-reported output tokens,
# or reserves the requested maximum when the provider omits usage metadata.
DEBATE_MAX_CHALLENGES=4
DEBATE_OUTPUT_TOKEN_BUDGET=6000
DEBATE_CALL_TIMEOUT_SECONDS=120
LLM_MAX_MODEL_ATTEMPTS=7
LLM_GLOBAL_DAILY_CALL_BUDGET=500
LLM_PROVIDER_DAILY_CALL_BUDGET=250
LLM_DEPARTMENT_DAILY_CALL_BUDGET=300
LLM_AGENT_DAILY_CALL_BUDGET=150

# Used by the War Room when WARROOM_GEMINI_MODEL is empty. The backend tries
# these in order; unavailable model IDs fall through to the next entry.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# Optional live data enrichments. The scanner also uses public DexScreener data.
COINGECKO_API_KEY=
# Optional Exa web search for sourced War Room research. Never exposed to the browser.
EXA_API_KEY=
EXA_DAILY_CALL_BUDGET=20
# Optional Alpha Vantage TIME_SERIES_DAILY feed for authenticated stock history.
# This is historical daily OHLCV, never represented as real-time pricing.
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_DAILY_CALL_BUDGET=20
# Daily historical OHLCV only. Alpha Vantage documents 25 free API calls/day;
# commercial redistribution requires an authorized commercial arrangement.
# Leave disabled until the applicable data terms are reviewed. Values:
# disabled, personal_noncommercial, commercial_authorized.
ALPHA_VANTAGE_LICENSE_STATUS=disabled
WARROOM_STOCK_SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA
# Public shared mainnet RPCs; health checked 2026-11-16; rate limits/no SLA; use dedicated RPCs for production.
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
BSC_RPC_URL=https://bsc-rpc.publicnode.com
BASE_RPC_URL=https://base-rpc.publicnode.com
SOLANA_RPC_URL=https://solana-rpc.publicnode.com
# Optional browser-side public RPC for Dashboard wallet balance/send. This value is public,
# embedded in the frontend bundle, and should not contain a private API key.
VITE_SOLANA_RPC_URL=

# Optional A2A Agent Card URLs for War Room research only. Configure trusted,
# public HTTPS endpoints separated by commas; browser requests cannot add URLs.
WARROOM_A2A_AGENT_CARDS=
A2A_TIMEOUT_SECONDS=12

# Department credentials are separate. Keys stay on the backend.
# Optional public Reown/WalletConnect project ID enables mobile WalletConnect sessions in the web wallet chooser.
VITE_WALLETCONNECT_PROJECT_ID=
WARROOM_PROVIDERS=gemini,cerebras,openrouter
WARROOM_GEMINI_API_KEY=
WARROOM_GEMINI_MODEL=
WARROOM_OPENROUTER_API_KEY=
WARROOM_OPENROUTER_MODEL=
WARROOM_CEREBRAS_API_KEY=
WARROOM_CEREBRAS_MODEL=

TRADING_PROVIDERS=gemini,openrouter,cerebras
TRADING_GEMINI_API_KEY=
TRADING_GEMINI_MODEL=
TRADING_OPENROUTER_API_KEY=
TRADING_OPENROUTER_MODEL=
TRADING_CEREBRAS_API_KEY=
TRADING_CEREBRAS_MODEL=

# Zecto settings not previously present in this local configuration
APP_NAME=Zecto
PRICE_ALERT_CHECK_INTERVAL_SECONDS=300
METRICS_BEARER_TOKEN=
